{
  "expo": {
    "name": "offline-expense-tracker",
    "slug": "offline-expense-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/offline_expense_tracker.png",
    "scheme": "offlineexpensetracker",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nisharga.sharetasking.offlineexpensetracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "This app uses FaceID to secure your financial data.",
        "NSMicrophoneUsageDescription": "This app requires microphone access to record your expenses.",
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition to convert your voice to expense text.",
        "NSUserNotificationsUsageDescription": "We need to send you daily reminders so you don't forget to log your expenses."
      } 
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D3C59",
        "foregroundImage": "./assets/offline_expense_tracker.png",
        "backgroundImage": "./assets/offline_expense_tracker.png",
        "monochromeImage": "./assets/offline_expense_tracker.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nisharga.sharetasking.offlineexpensetracker",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo-new.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2D3C59",
          "dark": {
            "backgroundColor": "#2D3C59"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to recognize your speech"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ed60abe-f689-4dc6-95ff-21f0d1230ca4"
      }
    }
  }
}
