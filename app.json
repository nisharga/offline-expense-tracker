{
  "expo": {
    "name": "offline-expense-tracker",
    "slug": "offline-expense-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/offline_expense_tracker.png",
    "scheme": "offlineexpensetracker",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nisharga.sharetasking.offlineexpensetracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D3C59",
        "foregroundImage": "./assets/offline_expense_tracker.png",
        "backgroundImage": "./assets/offline_expense_tracker.png",
        "monochromeImage": "./assets/offline_expense_tracker.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.nisharga.sharetasking.offlineexpensetracker"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo-new.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2D3C59",
          "dark": {
            "backgroundColor": "#2D3C59"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ed60abe-f689-4dc6-95ff-21f0d1230ca4"
      }
    }
  }
}
